<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!-- Mirrors Arc's AppleScript dictionary (same terms and codes), so Arc scripts work
     after changing the application name. Implemented in Scripting.swift. -->
<dictionary title="Arcky Terminology">
    <suite name="Standard Suite" code="core" description="Common classes and commands.">
        <command name="make" code="corecrel" description="Create a new tab.">
            <cocoa class="NSCreateCommand"/>
            <parameter name="new" code="kocl" type="type" description="The class of the new object.">
                <cocoa key="ObjectClass"/>
            </parameter>
            <parameter name="at" code="insh" type="location specifier" optional="yes" description="Where to insert it.">
                <cocoa key="Location"/>
            </parameter>
            <parameter name="with properties" code="prdt" type="record" optional="yes" description="Initial values, e.g. {URL:&quot;https://example.com&quot;}.">
                <cocoa key="KeyDictionary"/>
            </parameter>
            <result type="specifier" description="The new object."/>
        </command>

        <command name="count" code="corecnte" description="Count the elements of an object.">
            <cocoa class="NSCountCommand"/>
            <direct-parameter type="specifier" description="The objects to count."/>
            <parameter name="each" code="kocl" type="type" optional="yes" description="The class of objects to count.">
                <cocoa key="ObjectClass"/>
            </parameter>
            <result type="integer"/>
        </command>

        <command name="close" code="coreclos" description="Close a tab.">
            <cocoa class="NSCloseCommand"/>
            <direct-parameter type="specifier" description="The tab to close."/>
        </command>

        <class name="application" code="capp" description="Arcky.">
            <cocoa class="NSApplication"/>
            <element type="window" access="r">
                <cocoa key="scriptWindows"/>
            </element>
            <element type="tab" access="r" description="The tabs of the front window.">
                <cocoa key="scriptTabs"/>
            </element>
            <property name="name" code="pnam" type="text" access="r"/>
            <property name="frontmost" code="pisf" type="boolean" access="r">
                <cocoa key="isActive"/>
            </property>
            <property name="version" code="vers" type="text" access="r"/>
        </class>

        <class name="window" code="WiND" plural="windows" description="A browser window.">
            <cocoa class="ScriptWindow"/>
            <element type="tab" access="rw">
                <cocoa key="tabs"/>
            </element>
            <element type="space" access="r">
                <cocoa key="spaces"/>
            </element>
            <property name="id" code="ID  " type="text" access="r">
                <cocoa key="uniqueID"/>
            </property>
            <property name="name" code="pnam" type="text" access="r"/>
            <property name="index" code="pidx" type="integer" access="r"/>
            <property name="active tab" code="acTa" type="tab" access="r">
                <cocoa key="activeTab"/>
            </property>
            <property name="active space" code="acSp" type="space" access="r">
                <cocoa key="activeSpace"/>
            </property>
            <property name="incognito" code="inco" type="boolean" access="r"/>
            <property name="mode" code="mode" type="text" access="r"/>
        </class>
    </suite>

    <suite name="Arcky Suite" code="CrSu" description="Tabs and spaces.">
        <command name="select" code="CrSelect" description="Make a tab the active one.">
            <direct-parameter type="specifier"/>
        </command>
        <command name="go back" code="CrSuBack" description="Go back in a tab's history.">
            <direct-parameter type="specifier"/>
        </command>
        <command name="go forward" code="CrSuFwd " description="Go forward in a tab's history.">
            <direct-parameter type="specifier"/>
        </command>
        <command name="reload" code="CrSuRlod" description="Reload a tab.">
            <direct-parameter type="specifier"/>
        </command>
        <command name="stop" code="CrSustop" description="Stop loading a tab.">
            <direct-parameter type="specifier"/>
        </command>
        <command name="execute" code="CrSuExJa" description="Run JavaScript in a tab and return the result as text.">
            <direct-parameter type="specifier"/>
            <parameter name="javascript" code="JvSc" type="text">
                <cocoa key="javascript"/>
            </parameter>
            <result type="text"/>
        </command>
        <command name="focus" code="SpaFocus" description="Switch to a space.">
            <direct-parameter type="specifier"/>
        </command>

        <class name="tab" code="tAbB" plural="tabs" description="A tab.">
            <cocoa class="ScriptTab"/>
            <property name="id" code="ID  " type="text" access="r">
                <cocoa key="uniqueID"/>
            </property>
            <property name="title" code="pnam" type="text" access="r"/>
            <property name="URL" code="URL " type="text" access="rw">
                <cocoa key="url"/>
            </property>
            <property name="loading" code="ldng" type="boolean" access="r"/>
            <property name="location" code="loca" type="text" access="r" description="&quot;topApp&quot; (a favorite), &quot;pinned&quot; or &quot;unpinned&quot;."/>
            <responds-to command="select"><cocoa method="handleSelectCommand:"/></responds-to>
            <responds-to command="go back"><cocoa method="handleGoBackCommand:"/></responds-to>
            <responds-to command="go forward"><cocoa method="handleGoForwardCommand:"/></responds-to>
            <responds-to command="reload"><cocoa method="handleReloadCommand:"/></responds-to>
            <responds-to command="stop"><cocoa method="handleStopCommand:"/></responds-to>
            <responds-to command="execute"><cocoa method="handleExecuteCommand:"/></responds-to>
            <responds-to command="close"><cocoa method="handleCloseScriptCommand:"/></responds-to>
        </class>

        <class name="space" code="sPaC" plural="spaces" description="A space.">
            <cocoa class="ScriptSpace"/>
            <property name="id" code="ID  " type="text" access="r">
                <cocoa key="uniqueID"/>
            </property>
            <property name="title" code="pnam" type="text" access="r"/>
            <element type="tab" access="r">
                <cocoa key="tabs"/>
            </element>
            <responds-to command="focus"><cocoa method="handleFocusCommand:"/></responds-to>
        </class>
    </suite>
</dictionary>
